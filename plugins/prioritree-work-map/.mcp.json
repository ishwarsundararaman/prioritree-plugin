{
  "mcpServers": {
    "prioritree_work_map": {
      "command": "cmd.exe",
      "args": [
        "/d",
        "/c",
        "scripts\\launch-work-map.cmd",
        "codex"
      ],
      "cwd": ".",
      "env_vars": [
        "PATH",
        "USERPROFILE",
        "LOCALAPPDATA",
        "APPDATA",
        "HOME",
        "CODEX_HOME",
        "CODEX_CLI_PATH",
        "CODEX_MCP_NODE_PATH",
        "CODEX_MANAGED_PACKAGE_ROOT",
        "PRIORITREE_CODEX_CLI",
        "PRIORITREE_WORK_STORE_DIR"
      ],
      "tool_timeout_sec": 120
    }
  }
}
